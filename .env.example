# Configures pi atlassian environment.
PI_ATLASSIAN_ENVIRONMENT=development
# Configures pi atlassian access mode.
PI_ATLASSIAN_ACCESS_MODE=READ_ONLY
# Enables or disables pi atlassian write enabled.
PI_ATLASSIAN_WRITE_ENABLED=false
# Secret value for pi atlassian internal api key; inject it per environment and never commit a real value.
PI_ATLASSIAN_INTERNAL_API_KEY=replace-with-a-long-random-value
# Secret value for pi atlassian forge webhook secret; inject it per environment and never commit a real value.
PI_ATLASSIAN_FORGE_WEBHOOK_SECRET=replace-with-a-long-random-value
# Network location for pi atlassian forge config url.
PI_ATLASSIAN_FORGE_CONFIG_URL=
# Secret value for pi atlassian forge config secret; inject it per environment and never commit a real value.
PI_ATLASSIAN_FORGE_CONFIG_SECRET=replace-with-a-different-long-random-value
# Network location for pi atlassian rovo mcp url.
PI_ATLASSIAN_ROVO_MCP_URL=https://mcp.atlassian.com/v2/mcp?tools=all
# Configures pi atlassian rovo service auth mode.
PI_ATLASSIAN_ROVO_SERVICE_AUTH_MODE=BEARER
# Configures pi atlassian rovo service username.
PI_ATLASSIAN_ROVO_SERVICE_USERNAME=
# Secret value for pi atlassian rovo service token; inject it per environment and never commit a real value.
PI_ATLASSIAN_ROVO_SERVICE_TOKEN=
# Network location for pi atlassian backend url.
PI_ATLASSIAN_BACKEND_URL=http://api:8000
# Secret value for pi atlassian backend internal api key; inject it per environment and never commit a real value.
PI_ATLASSIAN_BACKEND_INTERNAL_API_KEY=
# Network location for pi atlassian ingestion url.
PI_ATLASSIAN_INGESTION_URL=http://ingestion:8000
# Secret value for pi atlassian ingestion internal api key; inject it per environment and never commit a real value.
PI_ATLASSIAN_INGESTION_INTERNAL_API_KEY=
# Configures pi atlassian application projects.
PI_ATLASSIAN_APPLICATION_PROJECTS=
# Configures pi atlassian event max bytes.
PI_ATLASSIAN_EVENT_MAX_BYTES=262144
# Configures pi atlassian event max age seconds.
PI_ATLASSIAN_EVENT_MAX_AGE_SECONDS=300
# Configures pi atlassian event debounce seconds.
PI_ATLASSIAN_EVENT_DEBOUNCE_SECONDS=2
# Configures pi atlassian dispatch retry attempts.
PI_ATLASSIAN_DISPATCH_RETRY_ATTEMPTS=3
# Configures pi atlassian project catalog ttl seconds.
PI_ATLASSIAN_PROJECT_CATALOG_TTL_SECONDS=30
# Configures pi atlassian recovery scan seconds.
PI_ATLASSIAN_RECOVERY_SCAN_SECONDS=300
# Configures pi atlassian catch up timeout seconds.
PI_ATLASSIAN_CATCH_UP_TIMEOUT_SECONDS=1800
